{
  "name": "formpilot",
  "description": "AI form filling grounded in your own documents. Suggestions appear right under the field.",
  "private": true,
  "version": "0.1.0",
  "author": "Naman Pathak <namanpathak503@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Naman503/ai-personal-assistant-projects.git",
    "directory": "formpilot"
  },
  "type": "module",
  "scripts": {
    "dev": "(node scripts/fixture-server.mjs &) && wxt",
    "dev:brave": "(node scripts/fixture-server.mjs &) && wxt -b brave",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "lucide-react": "1.49.0",
    "mammoth": "1.13.0",
    "minisearch": "7.2.0",
    "partial-json": "0.1.7",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
